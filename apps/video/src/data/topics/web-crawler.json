 "steps": [
  {
   "title": "Crawler Service → links_to_crawl",
   "text": "The Crawler Service takes the highest-priority link from links_to_crawl. Priorities start from site popularity, so important pages are crawled first.",
   "nodes": [
    "Crawler Service",
    "links_to_crawl"
   ],
   "data": "extract_max_priority_page()\n→ {\n  \"url\": \"https://blog.example.org/raft-explained\",\n  \"priority\": 0.82\n}"
  },
  {
   "title": "Crawler Service → The Web",
   "text": "It fetches the page from The Web (respecting robots.txt and a per-site rate limit), then computes a signature from its content.",
   "nodes": [
    "Crawler Service",
    "The Web"
   ],
   "data": "GET https://blog.example.org/raft-explained\n→ 200 OK, 512 KB\nsignature = simhash(words) = b8808b33"
  },
  {
   "title": "Similar page crawled? → crawled_links",
   "text": "Similar page crawled? No signature in crawled_links is close, so this is new content.",
   "nodes": [
    "Similar page crawled?",
    "crawled_links"
   ],
   "data": "crawled_similar(b8808b33) → none"
  },
  {
   "title": "Two jobs are queued",
   "text": "Two jobs are queued: one for the Reverse Index Service (which words appear on which pages) and one for the Document Service (a static title and snippet). Queues let crawling run at its own pace.",
   "nodes": [
    "Crawler Service",
    "Reverse Index Queue",
    "Document Queue"
   ],
   "data": "reverse_index_queue.put({\n  \"url\": \"https://blog.example.org/raft-explained\",\n  \"words\": [\n    \"raft\",\n    \"consensus\",\n    \"leader\",\n    \"election\",\n    \"log\"\n  ]\n})\ndoc_queue.put({\n  \"url\": \"https://blog.example.org/raft-explained\",\n  \"title\": \"Raft, explained\"\n})"
  },
  {
   "title": "links_to_crawl → crawled_links",
   "text": "The link moves from links_to_crawl to crawled_links with its signature, and the page's own links are added to links_to_crawl for later.",
   "nodes": [
    "links_to_crawl",
    "crawled_links"
   ],
   "data": "remove_link_to_crawl(\"https://blog.example.org/raft-explained\")\ninsert_crawled_link(\"https://blog.example.org/raft-explained\", \"b8808b33\")\nadd_link_to_crawl(…14 child links)"
  },
  {
   "title": "Reverse Index Service → Reverse Index",
   "text": "The Reverse Index Service adds the page to each word's posting list in the Reverse Index; the Document Service stores its title and snippet.",
   "nodes": [
    "Reverse Index Service",
    "Reverse Index",
    "Document Service",
    "Titles & Snippets"
   ],
   "data": "raft       → [..., \"https://blog.example.org/raft-explained\"]\nconsensus  → [..., \"https://blog.example.org/raft-explained\"]\nleader     → [..., \"https://blog.example.org/raft-explained\"]\nelection   → [..., \"https://blog.example.org/raft-explained\"]\nlog        → [..., \"https://blog.example.org/raft-explained\"]"
  },
  {
   "title": "User → Web Server",
   "text": "Later, someone searches for \"raft consensus\". The Query API parses the query, finds matching pages in the Reverse Index, ranks them, and fetches titles and snippets.",
   "nodes": [
    "User",
    "Web Server",
    "Query API",
    "Reverse Index",
    "Titles & Snippets"
   ],
   "data": "GET /api/v1/search?query=raft+consensus\n→ [\n  {\n    \"title\": \"Raft, explained\",\n    \"snippet\": \"…raft consensus leader election log…\",\n    \"link\": \"https://blog.example.org/raft-explained\"\n  }\n]"
  }
 ],
 "takeaways": [
  "Crawl from a priority queue (the frontier), seeded by site popularity.",
  "Detect duplicate content with page signatures, or the crawler loops and wastes work.",
  "Lower a duplicate's priority instead of crawling it again.",
  "Hand indexing and snippet generation to queues so crawling never waits on them."
 ],
 "credit": "Adapted from Design a web crawler, Donne Martin, System Design Primer (CC BY 4.0)"
}
