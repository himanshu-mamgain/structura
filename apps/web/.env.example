# URL of the API server when it is not on the same origin, e.g. https://structura-api.onrender.com
# Leave empty in development (Vite proxies /api to localhost:3001).
VITE_API_URL=

# tldraw license key, required on production domains (not localhost). Get one at https://tldraw.dev/pricing
VITE_TLDRAW_LICENSE_KEY=
