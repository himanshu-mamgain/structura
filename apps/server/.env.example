# Which AI provider answers the assistant: gemini or claude.
# Defaults to gemini when GEMINI_API_KEY is set, otherwise claude.
AI_PROVIDER=

# Google Gemini (free tier available): https://aistudio.google.com/apikey
GEMINI_API_KEY=
# Optional. Comma-separated models, tried in order when one is overloaded.
# GEMINI_MODEL=gemini-flash-latest,gemini-flash-lite-latest

# Anthropic Claude: https://console.anthropic.com
ANTHROPIC_API_KEY=
# Optional.
# CLAUDE_MODEL=claude-opus-5-5
