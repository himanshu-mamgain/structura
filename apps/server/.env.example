# Which AI provider answers the assistant: ollama (default), gemini or claude.
AI_PROVIDER=ollama

# Local Ollama (https://ollama.com). The server must be able to reach it.
# OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=qwen3.5:2b-q4_K_M
# Optional tuning: context size, max answer length, screenshots and thinking (slower).
# OLLAMA_NUM_CTX=8192
# OLLAMA_NUM_PREDICT=3000
# OLLAMA_VISION=false
# OLLAMA_THINK=false

# Google Gemini (free tier available): https://aistudio.google.com/apikey
# GEMINI_API_KEY=
# GEMINI_MODEL=gemini-3.7-flash,gemini-3.5-flash-lite,gemini-flash-lite-latest

# Anthropic Claude: https://console.anthropic.com
# ANTHROPIC_API_KEY=
# CLAUDE_MODEL=claude-opus-5-5
