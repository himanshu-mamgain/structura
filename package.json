{
  "name": "structura",
  "private": true,
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "npm run dev -w @structura/web",
    "build": "npm run build --workspaces --if-present",
    "lan": "npm run build -w @structura/web && npm run preview -w @structura/web",
    "typecheck": "npm run typecheck --workspaces --if-present && tsc -p netlify",
    "test:push": "tsx --test netlify/lib/push.test.ts"
  },
  "engines": {
    "node": ">=20"
  },
  "devDependencies": {
    "@netlify/functions": "^6.1.1",
    "@types/web-push": "^3.6.4",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  },
  "dependencies": {
    "@netlify/blobs": "^11.1.8",
    "web-push": "^4.0.0"
  }
}
