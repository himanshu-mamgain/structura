{
  "name": "structura",
  "private": true,
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "npm run dev -w @structura/web",
    "build": "npm run build --workspaces --if-present",
    "lan": "npm run build -w @structura/web && npm run preview -w @structura/web",
    "typecheck": "npm run typecheck --workspaces --if-present"
  },
  "engines": {
    "node": ">=20"
  },
  "devDependencies": {
    "typescript": "^7.0.2"
  }
}
